#include "funciones.h"

int main() {
    int opcion;

    do {
        printf("\n====================================");
        printf("\n SISTEMA SGIC - RUEDAS DE ORO");
        printf("\n====================================");
        printf("\n1. Registrar Vehiculo");
        printf("\n2. Mostrar Vehiculos");
        printf("\n3. Buscar Vehiculos");
        printf("\n4. Registrar Cliente");
        printf("\n5. Mostrar Clientes");
        printf("\n6. Realizar Venta");
        printf("\n7. Mostrar Ventas");
        printf("\n8. Reporte Inventario");
        printf("\n0. Salir");
        printf("\nSeleccione una opcion: ");
        scanf("%d", &opcion);

        switch(opcion){
            case 1:
                registrarVehiculo();
                break;
            case 2:
                mostrarVehiculos();
                break;
            case 3:
                buscarVehiculos();
                break;
            case 4:
                registrarCliente();
                break;
            case 5:
                mostrarClientes();
                break;
            case 6:
                realizarVenta();
                break;
            case 7:
                mostrarVentas();
                break;
            case 8:
                reporteInventario();
                break;
            case 0:
                printf("\nSaliendo...\n");
                break;
            default:
                printf("\nOpcion invalida.\n");
        }

    } while(opcion != 0);

    return 0;
}
