#include <stdio.h>
#include <string.h>

#define MAX 10


struct Libro {
    int id;
    char titulo[100];
    char autor[50];
    int anio;
    char estado[15]; 
};

struct Libro biblioteca[MAX];
int total = 0;


void registrarLibro();
void mostrarLibros();
void buscarLibro();
void actualizarEstado();
void eliminarLibro();
int buscarIndicePorID(int id);

int main() {
    int opcion;

    do {
        printf("\n===== SISTEMA DE BIBLIOTECA =====\n");
        printf("1. Registrar libro\n");
        printf("2. Mostrar libros\n");
        printf("3. Buscar libro\n");
        printf("4. Actualizar estado\n");
        printf("5. Eliminar libro\n");
        printf("0. Salir\n");
        printf("Seleccione una opcion: ");
        scanf("%d", &opcion);

        switch(opcion) {
            case 1: registrarLibro(); break;
            case 2: mostrarLibros(); break;
            case 3: buscarLibro(); break;
            case 4: actualizarEstado(); break;
            case 5: eliminarLibro(); break;
            case 0: printf("Saliendo...\n"); break;
            default: printf("Opcion invalida\n");
        }

    } while(opcion != 0);

    return 0;
}


void registrarLibro() {
    if(total >= MAX) {
        printf("No se pueden registrar mas libros.\n");
        return;
    }

    int id;
    printf("Ingrese ID del libro: ");
    scanf("%d", &id);

   
    if(buscarIndicePorID(id) != -1) {
        printf("Error: el ID ya existe.\n");
        return;
    }

    biblioteca[total].id = id;

    printf("Ingrese titulo: ");
    getchar(); 
    fgets(biblioteca[total].titulo, 100, stdin);
    biblioteca[total].titulo[strcspn(biblioteca[total].titulo, "\n")] = 0;

    printf("Ingrese autor: ");
    fgets(biblioteca[total].autor, 50, stdin);
    biblioteca[total].autor[strcspn(biblioteca[total].autor, "\n")] = 0;

    printf("Ingrese año de publicación: ");
    scanf("%d", &biblioteca[total].anio);

    strcpy(biblioteca[total].estado, "Disponible");

    total++;

    printf("Libro registrado correctamente.\n");
}


void mostrarLibros() {
    if(total == 0) {
        printf("No hay libros registrados.\n");
        return;
    }

    printf("\nID | TITULO | AUTOR | AÑO | ESTADO\n");
    printf("-----------------------------------------------------\n");

    for(int i = 0; i < total; i++) {
        printf("%d | %s | %s | %d | %s\n",
            biblioteca[i].id,
            biblioteca[i].titulo,
            biblioteca[i].autor,
            biblioteca[i].anio,
            biblioteca[i].estado);
    }
}


void buscarLibro() {
    int opcion, id;
    char titulo[100];

    printf("Buscar por: 1.ID  2.Titulo: ");
    scanf("%d", &opcion);

    if(opcion == 1) {
        printf("Ingrese ID: ");
        scanf("%d", &id);

        int pos = buscarIndicePorID(id);
        if(pos == -1) {
            printf("Libro no encontrado.\n");
        } else {
            printf("Encontrado: %s | %s | %d | %s\n",
                biblioteca[pos].titulo,
                biblioteca[pos].autor,
                biblioteca[pos].anio,
                biblioteca[pos].estado);
        }

    } else if(opcion == 2) {
        printf("Ingrese titulo: ");
        getchar();
        fgets(titulo, 100, stdin);
        titulo[strcspn(titulo, "\n")] = 0;

        int encontrado = 0;

        for(int i = 0; i < total; i++) {
            if(strcmp(biblioteca[i].titulo, titulo) == 0) {
                printf("Encontrado: ID %d | %s | %s | %d | %s\n",
                    biblioteca[i].id,
                    biblioteca[i].titulo,
                    biblioteca[i].autor,
                    biblioteca[i].anio,
                    biblioteca[i].estado);
                encontrado = 1;
            }
        }

        if(!encontrado) {
            printf("No encontrado.\n");
        }

    } else {
        printf("Opcion invalida.\n");
    }
}

void actualizarEstado() {
    int id;
    printf("Ingrese ID del libro: ");
    scanf("%d", &id);

    int pos = buscarIndicePorID(id);

    if(pos == -1) {
        printf("Libro no encontrado.\n");
        return;
    }

    if(strcmp(biblioteca[pos].estado, "Disponible") == 0) {
        strcpy(biblioteca[pos].estado, "Prestado");
    } else {
        strcpy(biblioteca[pos].estado, "Disponible");
    }

    printf("Estado actualizado correctamente.\n");
}

void eliminarLibro() {
    int id;
    printf("Ingrese ID del libro a eliminar: ");
    scanf("%d", &id);

    int pos = buscarIndicePorID(id);

    if(pos == -1) {
        printf("Libro no encontrado.\n");
        return;
    }

    for(int i = pos; i < total - 1; i++) {
        biblioteca[i] = biblioteca[i + 1];
    }

    total--;

    printf("Libro eliminado correctamente.\n");
}


int buscarIndicePorID(int id) {
    for(int i = 0; i < total; i++) {
        if(biblioteca[i].id == id) {
            return i;
        }
    }
    return -1;
}
